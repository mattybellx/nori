# nori configuration template.
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
#
#   cp .env.example .env        (Windows: copy .env.example .env)

# --- DeepSeek API ---------------------------------------------------------
# Your API token from https://platform.deepseek.com -> API Keys.
# Required for --provider deepseek (and openai / github providers).
DSE_PROVIDER_KEY=

# Model names for the two tiers (strategies use "cheap" first, escalate to
# "expensive" on low confidence). Defaults to DeepSeek V4 Flash for both.
DSE_MODEL_CHEAP=deepseek-v4-flash
DSE_MODEL_EXPENSIVE=deepseek-v4-flash

# --- Other providers ------------------------------------------------------
# --provider ollama  : no key needed (defaults to http://localhost:11434/v1)
# --provider openai  : set DSE_PROVIDER_KEY to your OpenAI key
# --provider github  : set DSE_PROVIDER_KEY to a GitHub PAT (GitHub Models)

# --- Optional overrides ---------------------------------------------------
# DSE_PROVIDER_URL=https://api.deepseek.com
# DSE_TIMEOUT=120
